# Environment variables for direct Deepgram streaming

# Deepgram API Key - Get from https://console.deepgram.com/
# This enables direct WebSocket streaming without backend
REACT_APP_DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxx
# Optional: Google Gemini API Key for summarization (if keeping summarization feature)
# REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here
